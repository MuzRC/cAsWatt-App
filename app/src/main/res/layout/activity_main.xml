<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121318">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:background="#181A22">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ CasWatt Pro v4.1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengesan Kuasa • Kesihatan Bateri • Rekod Harian"
            android:textColor="#78909C"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Container Frame for Tabs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= TAB 1: UTAMA (DASHBOARD) ================= -->
        <ScrollView
            android:id="@+id/view_tab_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Kad Kuasa Utama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tv_main_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEMERIKSA..."
                        android:textColor="#FFAB00"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_main_watt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 W"
                        android:textColor="#00E676"
                        android:textSize="50sp"
                        android:textStyle="bold"
                        android:layout_marginVertical="6dp" />

                    <TextView
                        android:id="@+id/tv_main_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arus: 0 mA"
                        android:textColor="#ECEFF1"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tv_main_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voltan: 0.00 V"
                        android:textColor="#ECEFF1"
                        android:textSize="17sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Tempoh Nyahcas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Tempoh Nyahcas (Sejak Cabut Pengecas)"
                        android:textColor="#90A4AE"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_discharge_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0j 0m 0s"
                        android:textColor="#29B6F6"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_discharge_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bateri semasa: 100% (Turun 0%)"
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 2 Kad Sebelah Menyebelah: Peak Watt & Total Energy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/widget_background"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀 Watt Puncak"
                            android:textColor="#90A4AE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_peak_watt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 W"
                            android:textColor="#00E676"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Reset Sesi"
                            android:textColor="#546E7A"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/widget_background"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋 Tenaga Diserap"
                            android:textColor="#90A4AE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_mah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 mAh"
                            android:textColor="#29B6F6"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kapasiti Masuk Sesi"
                            android:textColor="#546E7A"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kad Maklumat Bateri & Auto Reset Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_main_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peratus Bateri: --%"
                        android:textColor="#CFD8DC"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_main_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suhu Bateri: -- °C"
                        android:textColor="#CFD8DC"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_main_plug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sumber Cas: Tiada"
                        android:textColor="#CFD8DC"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 Auto-Reset aktif: Watt puncak &amp; mAh akan reset sendiri setiap kali wayar dicucuk semula."
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_reset_session"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Reset Manual Sesi Cas"
                    android:backgroundTint="#37474F"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 2: STATISTIK HARIAN & GRAF ================= -->
        <ScrollView
            android:id="@+id/view_tab_stats_graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Statistik Pengecasan Hari Ini"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_today_charge_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Berapa Kali Dicas Hari Ini: 0 kali"
                        android:textColor="#00E676"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_today_total_mah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Tenaga Masuk Hari Ini: 0 mAh"
                        android:textColor="#ECEFF1"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_today_peak_watt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watt Puncak Hari Ini: 0.00 W"
                        android:textColor="#ECEFF1"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜 Rekod Kekerapan Cas Harian (Disimpan)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/ll_daily_history_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_empty_daily_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiada rekod harian lama lagi. Cucuk pengecas untuk mula merekod!"
                        android:textColor="#90A4AE"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Keluk Pengecasan Masa-Nyata (Watt &amp; Suhu)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#00E676"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Kuasa (Watt)"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FF9100"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Suhu (°C)"
                        android:textColor="#FF9100"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.caswatt.app.ChargingChartView
                    android:id="@+id/charging_chart_view"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/widget_background"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_clear_graph"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Padam Keluk Graf"
                    android:backgroundTint="#37474F"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 3: REKOD KESIHATAN BATERI ================= -->
        <ScrollView
            android:id="@+id/view_tab_health"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺 Rekod &amp; Kesihatan Bateri"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pantau keadaan sel kimia, kitaran cas, dan kesihatan perkakasan telefon."
                    android:textColor="#78909C"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status Kesihatan Perkakasan OS:"
                        android:textColor="#90A4AE"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sihat &amp; Baik (Good)"
                        android:textColor="#00E676"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginVertical="6dp" />

                    <TextView
                        android:id="@+id/tv_health_cycles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anggaran Kitaran Pengecasan: 0.0 kitaran"
                        android:textColor="#ECEFF1"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_health_cumulative"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Kumulatif Cas: 0% cas"
                        android:textColor="#90A4AE"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Keadaan Fizikal Sel Bateri Semasa:"
                        android:textColor="#ECEFF1"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_health_voltage_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voltan Sel: 0.00 V (Voltan sihat lithium ~3.7V - 4.4V)"
                        android:textColor="#CFD8DC"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_temp_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suhu Sel: 0.0 °C (Zon Selamat &lt; 40°C)"
                        android:textColor="#CFD8DC"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Petua Memanjangkan Hayat Bateri (Lithium):"
                        android:textColor="#00E676"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Hadkan cas sehingga 80% (mengelakkan tekanan voltan tinggi pada anod bateri).
2. Jangan biar bateri cecah 0% terlalu kerap.
3. Jangan guna telefon untuk kerja berat semasa cas pantas jika suhu cecah 42°C ke atas."
                        android:textColor="#B0BEC5"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 4: PENGGERA & TETAPAN ================= -->
        <ScrollView
            android:id="@+id/view_tab_settings_alarm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔 Tetapan Penggera &amp; Servis"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Kad Penggera Had Bateri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Penggera Had Bateri"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_battery_alarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_battery_alarm_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Berbunyi &amp; bergetar apabila bateri cecah 80%"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_thresh_80"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="80%"
                            android:textSize="12sp"
                            android:backgroundTint="#00E676"
                            android:textColor="#121318"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_thresh_85"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="85%"
                            android:textSize="12sp"
                            android:backgroundTint="#263238"
                            android:textColor="#FFFFFF"
                            android:layout_marginHorizontal="2dp" />

                        <Button
                            android:id="@+id/btn_thresh_90"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="90%"
                            android:textSize="12sp"
                            android:backgroundTint="#263238"
                            android:textColor="#FFFFFF"
                            android:layout_marginHorizontal="2dp" />

                        <Button
                            android:id="@+id/btn_thresh_100"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="100%"
                            android:textSize="12sp"
                            android:backgroundTint="#263238"
                            android:textColor="#FFFFFF"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kad Penggera Suhu Panas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Penggera Suhu Bateri Panas"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_temp_alarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_temp_alarm_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amaran kecemasan jika suhu cecah 45.0 °C"
                        android:textColor="#FF9100"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_temp_42"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="42°C"
                            android:textSize="12sp"
                            android:backgroundTint="#263238"
                            android:textColor="#FFFFFF"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_temp_45"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="45°C"
                            android:textSize="12sp"
                            android:backgroundTint="#FF9100"
                            android:textColor="#121318"
                            android:layout_marginHorizontal="2dp" />

                        <Button
                            android:id="@+id/btn_temp_48"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="48°C"
                            android:textSize="12sp"
                            android:backgroundTint="#263238"
                            android:textColor="#FFFFFF"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔔 Uji Bunyi &amp; Getaran Penggera"
                    android:backgroundTint="#2979FF"
