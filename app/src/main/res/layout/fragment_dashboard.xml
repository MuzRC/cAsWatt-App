<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Cas Utama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_main_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMERIKSA STATUS..."
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_main_watt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0.00 W"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_main_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Arus Bersih: 0 mA"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_main_voltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voltan: 0.00 V"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

            <!-- Baris Nisbah Aliran Kuasa (Sentuh untuk tukar unit mA / Watt) -->
            <LinearLayout
                android:id="@+id/layout_power_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_ratio_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aliran: "
                    android:textColor="#90A4AE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_input_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ 0 mA"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ratio_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_drain_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 0 mA"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_efficiency_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#263238"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="100%"
                    android:textColor="#80D8FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_thermal_throttle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⚠️ THERMAL THROTTLING AKTIF"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_trickle_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="💧 TRICKLE CHARGE (MENJAGA HAYAT)"
                android:textColor="#29B6F6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Kualiti Kabel dan Smart ETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kualiti Kabel: "
                    android:textColor="#CFD8DC"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_cable_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mengukur..."
                    android:textColor="#90A4AE"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_smart_eta_80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏱️ Anggaran ke 80%: --"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_smart_eta_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⏱️ Anggaran ke 100%: --"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tempoh Nyahcas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_discharge_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--:--"
                android:textColor="#29B6F6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_discharge_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bateri: --%"
                android:textColor="#90A4AE"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Metrik Kuasa dan Tenaga Sesi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tenaga Sesi Semasa"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_peak_watt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0.00 W"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_total_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 mAh"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_energy_wh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0.00 Wh"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cost_myr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RM 0.00"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_reset_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Set Semula Sesi Ini" />
        </LinearLayout>

        <!-- Maklumat Sistem Asas (Boleh disentuh untuk pintasan Tetapan Bateri OS) -->
        <LinearLayout
            android:id="@+id/layout_system_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tajuk Kad & Petunjuk Sentuh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Maklumat Sistem Asas"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tetapan ↗"
                    android:textColor="#90A4AE"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 1. Peratus Bateri (Cara 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peratus Bateri: "
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_main_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Suhu Bateri (Cara 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suhu Bateri: "
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_main_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Sumber Cas (Cara 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sumber Cas: "
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_main_plug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#29B6F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. CIRI BAHARU: Baki Hayat Nyahcas (Cara 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baki Masa Bertahan: "
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_main_runtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mengira..."
                    android:textColor="#80D8FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. CIRI BAHARU: Teknologi Kimia Sel (Cara 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teknologi Sel: "
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_main_tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Li-ion"
                    android:textColor="#ECEFF1"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
