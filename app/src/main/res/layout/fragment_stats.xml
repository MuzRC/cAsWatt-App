<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ringkasan Harian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_today_charge_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berapa Kali Dicas Hari Ini: 0 kali"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_today_total_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jumlah Tenaga Masuk Hari Ini: 0 mAh"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_today_peak_watt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Watt Puncak Hari Ini: 0.00 W"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_export_csv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Eksport Rekod ke CSV" />
        </LinearLayout>

        <!-- Graf Keluk Cas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graf Keluk Pengecasan Semasa"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.caswatt.app.ChargingChartView
                android:id="@+id/charging_chart_view"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_clear_graph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kosongkan Graf" />
        </LinearLayout>

        <!-- Senarai Sesi Cas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sejarah Sesi Cas Terperinci"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_session_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_toggle_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tampilkan Lebih Banyak ▼"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Senarai Rekod Harian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Harian"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_daily_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
