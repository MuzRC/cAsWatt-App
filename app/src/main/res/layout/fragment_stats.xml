<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. KAD RINGKASAN HARIAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_today_charge_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berapa Kali Dicas Hari Ini: 0 kali"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_today_total_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jumlah Tenaga Masuk Hari Ini: 0 mAh"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_today_peak_watt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Watt Puncak Hari Ini: 0.00 W"
                android:textColor="#CFD8DC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_export_csv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="40dp"
                android:backgroundTint="#21262D"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:text="📄 Eksport Rekod ke CSV" />
        </LinearLayout>

        <!-- 2. KAD GRAF KELUK PENGECASAN SEMASA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Baris Tajuk & Butang Padam Graf Kompak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Graf Keluk Pengecasan Semasa"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear_graph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:backgroundTint="#2D1517"
                    android:textColor="#FF5252"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:text="Kosongkan" />
            </LinearLayout>

            <!-- Petunjuk Warna Graf (Legend) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Kuasa (Watt)"
                    android:textColor="#00E676"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="● Suhu (°C)"
                    android:textColor="#FFAB00"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.caswatt.app.ChargingChartView
                android:id="@+id/charging_chart_view"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 3. KAD SEJARAH SESI CAS TERPERINCI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sejarah Sesi Cas Terperinci"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_session_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_toggle_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="38dp"
                android:backgroundTint="#21262D"
                android:textColor="#80D8FF"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:text="Tampilkan Lebih Banyak ▼"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. KAD ANALITIK TREND & LOG HARIAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E222B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analitik Trend &amp; Log Harian"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_daily_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
