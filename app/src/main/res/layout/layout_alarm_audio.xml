<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1. KAD KAWALAN OUTPUT AUDIO & WAKTU SENYAP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1E222B"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saluran Amaran &amp; Waktu Senyap"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Pilihan Saluran (Sound, Vibrate, TTS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_alarm_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nada"
                android:textColor="#CFD8DC"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_alarm_vibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Getar"
                android:textColor="#CFD8DC"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_alarm_tts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Suara TTS"
                android:textColor="#CFD8DC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Pemilih Nada Dering Sistem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_ringtone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nada: Penggera Sistem Lalai"
                android:textColor="#90A4AE"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_pick_ringtone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="34dp"
                android:backgroundTint="#21262D"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Pilih Nada 🎵"
                android:textAllCaps="false"
                android:textColor="#80D8FF"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#263238" />

        <!-- Waktu Senyap (Quiet Hours) -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_quiet_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mod Waktu Tidur (Waktu Senyap)"
            android:textColor="#CFD8DC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_quiet_hours_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Senyap dari 11:00 PM hingga 06:00 AM."
            android:textColor="#90A4AE"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#263238" />

        <!-- Ulangan Penggera (Loop Interval) -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_loop_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ulang Penggera Setiap 60 Saat"
            android:textColor="#CFD8DC"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Penggera terus berulang sehingga pengecas dicabut."
            android:textColor="#90A4AE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. KAD BUTANG UJI PENGGERA (KOMPAK) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#1E222B"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_test_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:backgroundTint="#00E676"
            android:text="🔊 Uji Bunyi Penggera &amp; Suara TTS"
            android:textAllCaps="false"
            android:textColor="#121318"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
