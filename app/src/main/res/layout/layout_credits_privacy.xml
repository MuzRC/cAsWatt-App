    <!-- 2. KAD VERSI APLIKASI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#1E222B"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versi Aplikasi"
            android:textColor="#FFA000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- TAMBAH ID INI SUPAYA KOTLIN KAU BOLEH BACA -->
        <TextView
            android:id="@+id/tv_credits_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CasWatt Pro v5.0.2"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CasWatt Pro Android APK (Release)"
            android:textColor="#90A4AE"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#263238"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Sokongan Android 8.0 - 15+"
            android:textColor="#FFB300"
            android:textSize="11sp" />
    </LinearLayout>
